#!/bin/bash
# ============================================================
# Git pre-commit hook - TEMPLATE_BRS
# Version : 2.0 — Secrets + Conventions PS
# ============================================================

echo ""
echo "============================================================"
echo "  PRE-COMMIT HOOK - TEMPLATE_BRS"
echo "============================================================"


test_pwsh() {
    "$1" -noprofile -c "exit 0" >/dev/null 2>&1
}

resolve_pwsh() {
    # 1. Vérifier d'abord les chemins par défaut de PowerShell 7
    for candidate in "/c/Program Files/PowerShell/7/pwsh.exe" "/mnt/c/Program Files/PowerShell/7/pwsh.exe"; do
        if [ -f "$candidate" ] && test_pwsh "$candidate"; then
            printf '%s' "$candidate"
            return 0
        fi
    done

    # 2. Vérifier dans le PATH (attention aux alias inactifs WindowsApps)
    if command -v pwsh.exe >/dev/null 2>&1 && test_pwsh "pwsh.exe"; then
        command -v pwsh.exe
        return 0
    fi
    if command -v pwsh >/dev/null 2>&1 && test_pwsh "pwsh"; then
        command -v pwsh
        return 0
    fi

    return 1
}

# ------------------------------------------------------------
# ÉTAPE INITIALE : Synchronisation des configurations IA
# ------------------------------------------------------------
echo "--> Synchronisation automatique des configurations et skills IA..."
SYNC_SCRIPT="C:\\Dev\\GitHub\\.agents\\Sync-IASkills.ps1"

PWSH="$(resolve_pwsh)"
if [ -z "$PWSH" ]; then
    echo "  [ERREUR] Exécutable PowerShell 7 (pwsh) introuvable ou alias WindowsApps inactif."
    echo "  Veuillez installer PowerShell 7 ou l'ajouter au PATH."
    exit 1
fi

if [ -f "$SYNC_SCRIPT" ] || [ -f "C:/Dev/GitHub/.agents/Sync-IASkills.ps1" ]; then
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File "C:\\Dev\\GitHub\\.agents\\Sync-IASkills.ps1" -DisableDryRun
    if [ $? -eq 0 ]; then
        echo "  [OK] Synchronisation IA terminée."
    else
        echo "  [ATTENTION] La synchronisation IA a échoué (code de retour non nul). Le commit continue."
    fi
else
    echo "  [INFO] Script de synchronisation IA introuvable, étape ignorée."
fi
echo ""

if command -v wslpath >/dev/null 2>&1; then
    REPO_ROOT_WSL=$(git rev-parse --show-toplevel)
    REPO_ROOT_WIN=$(wslpath -w "$REPO_ROOT_WSL" 2>/dev/null || echo "$REPO_ROOT_WSL")
elif command -v cygpath >/dev/null 2>&1; then
    REPO_ROOT_GIT=$(git rev-parse --show-toplevel)
    REPO_ROOT_WIN=$(cygpath -w "$REPO_ROOT_GIT" 2>/dev/null || echo "$REPO_ROOT_GIT")
else
    REPO_ROOT_WIN=$(git rev-parse --show-toplevel)
fi

# ------------------------------------------------------------
# ÉTAPE 1 : Scan des secrets
# ------------------------------------------------------------
echo "--> Étape 1/2 : Analyse des secrets..."
SCRIPT_SECRETS="${REPO_ROOT_WIN}\\Scan-Secrets.ps1"
"$PWSH" -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_SECRETS"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "  [ECHEC] Secrets détectés - commit bloqué."
    echo "  Corriger les alertes CRITIQUE avant de commiter."
    echo ""
    exit 1
fi

echo "  [OK] Aucun secret CRITIQUE détecté."
echo ""

# ------------------------------------------------------------
# ÉTAPE 2 : Vérification conventions PowerShell
# ------------------------------------------------------------
echo "--> Étape 2/2 : Vérification conventions PowerShell..."

# Récupère uniquement les fichiers .ps1 stagés (pas tous les fichiers)
STAGED_PS1=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ps1$')

if [ -z "$STAGED_PS1" ]; then
    echo "  [OK] Aucun fichier .ps1 dans ce commit."
else
    SCRIPT_CONV="${REPO_ROOT_WIN}\\PS-Convention-Check.ps1"

    if [ ! -f "$SCRIPT_CONV" ]; then
        echo "  [ATTENTION] PS-Convention-Check.ps1 introuvable — vérification ignorée."
    else
        # Lancer sur chaque fichier .ps1 stagé
        ALL_OK=true
        while IFS= read -r psfile; do
            PS1_WIN="${REPO_ROOT_WIN}\\${psfile//\//\\}"
            "$PWSH" -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_CONV" -Path "$PS1_WIN"
            if [ $? -ne 0 ]; then
                ALL_OK=false
            fi
        done <<< "$STAGED_PS1"

        if [ "$ALL_OK" = false ]; then
            echo ""
            echo "  [ECHEC] Violations de conventions PS détectées - commit bloqué."
            echo "  Corriger les violations avant de commiter."
            echo ""
            exit 1
        fi
    fi
fi

echo "  [OK] Conventions PowerShell respectées."
echo ""
echo "============================================================"
echo "  [OK] Tous les contrôles validés. Commit autorisé."
echo "============================================================"
echo ""
exit 0
